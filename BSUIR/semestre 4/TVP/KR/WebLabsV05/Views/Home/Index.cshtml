@*@using  WebLabsV05.Controllers*@
@using Microsoft.AspNetCore.Identity;
@using WebLabsV05.DAL.Entities;
@inject SignInManager<ApplicationUser> signInManager
@{
    ViewData["Title"] = "Index";
    var source = @ViewData["Lst"] as SelectList;
}
<h2>@ViewData["Text"]</h2>

    
<div class="container h-100 d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    @if (signInManager.IsSignedIn(User))
    {
        @await Component.InvokeAsync("Cart")

        <div class="d-flex flex-column align-items-center text-center p-4 border rounded shadow-sm bg-dark">
            <img src="@Url.Action("GetAvatar", "Image")"
                 width="100" height="100"
                 class="rounded-circle border mb-3"
                 alt="User Avatar" />

            <h5 class="mb-2 text-light">@User.Identity.Name</h5>
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnurl="@ViewContext.HttpContext.Request.Path">
                <button type="submit" class="btn btn-outline-danger mt-2">Выйти из аккаунта</button>
            </form>
        </div>
    }
    else
    {
        <div class="text-center p-4 border rounded shadow-sm bg-light">
            <h5 class="mb-3">Пожалуйста, авторизуйтесь или зарегистрируйтесь</h5>
            <div>
                <a class="btn btn-primary mr-2" asp-area="Identity" asp-page="/Account/Login">Войти</a>
                <a class="btn btn-secondary" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
            </div>
        </div>
    }
</div>

