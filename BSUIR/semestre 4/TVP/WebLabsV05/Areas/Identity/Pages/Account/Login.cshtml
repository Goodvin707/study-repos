@page
@model LoginModel

<div class="row justify-content-center">
    <div class="col-md-5">
        <section class="p-4 border rounded shadow-sm bg-white">
            <form id="account" method="post">
                <h3 class="mb-4 text-center">Вход в аккаунт</h3>

                <div class="form-group mb-3">
                    <label asp-for="Input.Email" class="form-label">Электронная почта</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="Введите email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Input.Password" class="form-label">Пароль</label>
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Введите пароль" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">Запомнить меня</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Войти</button>

                <div class="text-center mt-3">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Зарегистрироваться</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
