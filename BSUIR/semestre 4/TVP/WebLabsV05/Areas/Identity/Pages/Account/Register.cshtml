@page
@model RegisterModel
@{
   //ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <form asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" class="p-4 border rounded shadow-sm bg-white">
            <h3 class="mb-4 text-center">Регистрация нового пользователя</h3>

            <div class="form-group mb-3">
                <label asp-for="Input.Email" class="form-label">Электронная почта</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Введите email" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password" class="form-label">Пароль</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Введите пароль" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Подтверждение пароля</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Повторите пароль" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.Avatar" class="form-label">Аватар (необязательно)</label>
                <input asp-for="Input.Avatar" type="file" class="form-control-file" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
