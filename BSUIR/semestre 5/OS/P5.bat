@echo off
setlocal enabledelayedexpansion

REM Проверка наличия первого параметра
if "%1"=="" (
    echo Ошибка: Не указан первый параметр
    echo Использование: P5.bat [Редактор(1)^|Память(2)^|Директория(3)] [параметр2] [параметр3]
    exit /b 1
)

REM Обработка первого параметра
if /i "%1"=="1" goto Editor
if /i "%1"=="Редактор" goto Editor
if /i "%1"=="2" goto Memory
if /i "%1"=="Память" goto Memory
if /i "%1"=="3" goto Directory
if /i "%1"=="Директория" goto Directory

echo Ошибка: Неверный первый параметр "%1"
echo Допустимые значения: Редактор(1), Память(2), Директория(3)
exit /b 1

:Editor
echo Запуск редактора...
edit
goto :EOF

:Memory
REM Проверка наличия второго параметра для режима Память
if "%2"=="" (
    echo Ошибка: Для режима Память(2) требуется второй параметр (ключ)
    exit /b 1
)
echo Запуск программы Mem с ключом %2...
mem %2
goto :EOF

:Directory
REM Проверка наличия второго и третьего параметров для режима Директория
if "%2"=="" (
    echo Ошибка: Для режима Директория(3) требуется второй параметр (путь к директории)
    exit /b 1
)
if "%3"=="" (
    echo Ошибка: Для режима Директория(3) требуется третий параметр (путь для файла dir_3.txt)
    exit /b 1
)

echo Запись содержимого директории "%2" в файл "%3\dir_3.txt"...
dir "%2" > "%3\dir_3.txt"

if %errorlevel% equ 0 (
    echo Содержимое директории успешно записано в "%3\dir_3.txt"
) else (
    echo Ошибка при записи содержимого директории
    exit /b 1
)
goto :EOF