        <TextBox x:Name="TimeWork_mm" Style="{StaticResource placeHolder}" Tag="мм" HorizontalAlignment="Left" Height="22" Margin="569,69,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="32" RenderTransformOrigin="-1.742,2.522"/>
