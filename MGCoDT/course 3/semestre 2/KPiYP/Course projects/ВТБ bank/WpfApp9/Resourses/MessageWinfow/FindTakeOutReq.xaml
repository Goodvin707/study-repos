        <TextBox TextChanged="NextShh" x:Name="DateWork_yyyy" Style="{StaticResource placeHolder}" Tag="гггг" HorizontalAlignment="Left" Height="22" Margin="468,69,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="32" RenderTransformOrigin="-1.742,2.522" />
