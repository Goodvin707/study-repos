        <TextBox x:Name="PatrinymicLead_Copy2" Style="{StaticResource placeHolder}" Tag="Наименование организации" HorizontalAlignment="Left" Height="22" Margin="404,106,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="197" RenderTransformOrigin="-1.742,2.522"/>

