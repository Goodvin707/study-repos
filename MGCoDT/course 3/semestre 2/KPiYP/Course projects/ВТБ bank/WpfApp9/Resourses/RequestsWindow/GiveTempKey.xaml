<Window x:Class="WpfApp9.Resourses.RequestsWindow.GiveTempKey"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp9.Resourses.RequestsWindow"
        mc:Ignorable="d"
         Title="TakeTempPass"  Height="386" Width="355" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F8FF" >
        <Grid HorizontalAlignment="Center" Height="44" VerticalAlignment="Top" Width="355"  MouseDown="WindowMove">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0B2A74" Offset="0"/>
                    <GradientStop Color="#FF305790" Offset="0.499"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="closeapp" Margin="297,5,0,10" MaxHeight="29" MaxWidth="29" Source="/Resourses/Images/5968a2c8f2ed115d40bbe123.png" MouseDown="AppClose" MouseEnter="Up" Stretch="Fill" MouseLeave="Down" HorizontalAlignment="Left" Width="29"/>
            <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="270" Foreground="White" FontSize="14" Height="24"><Run Text="Cдача запасного ключа"/></TextBlock>

        </Grid>
        <GroupBox Header="Информация " Margin="10,49,0,0" BorderBrush="#FF0D2D76" FontSize="14" Height="277" VerticalAlignment="Top" HorizontalAlignment="Left" Width="335">
            <Grid Height="251" VerticalAlignment="Center" HorizontalAlignment="Left" Width="325">
                <GroupBox Header="Сдающий ключ:" Margin="0,10,0,0" Height="147" VerticalAlignment="Top" HorizontalAlignment="Center" Width="181">
                    <Grid>
                        <TextBox x:Name="Surname" HorizontalAlignment="Left" Height="23" Margin="10,10,0,0" TextWrapping="Wrap" Style="{StaticResource placeHolder}" Tag="Фамилия" VerticalAlignment="Top" Width="150" />
                        <TextBox x:Name="Name" HorizontalAlignment="Left" Height="23" Margin="10,38,0,0" TextWrapping="Wrap" Style="{StaticResource placeHolder}" Tag="Имя" VerticalAlignment="Top" Width="150" />
                        <TextBox x:Name="Patronymic" HorizontalAlignment="Left" Height="23" Margin="10,66,0,0" TextWrapping="Wrap" Style="{StaticResource placeHolder}" Tag="Отчество" VerticalAlignment="Top" Width="150" />
                        <Button Click="Button_Click_1" Content="Отчистить" HorizontalAlignment="Center" Margin="0,101,0,0" VerticalAlignment="Top" Width="90" FontSize="12"/>
                    </Grid>
                </GroupBox>
                <TextBox IsReadOnly="True" x:Name="PassNumber" HorizontalAlignment="Center" Height="23" Margin="0,171,0,0" TextWrapping="Wrap" Style="{StaticResource placeHolder}" Tag="Номер ключа" VerticalAlignment="Top" Width="182"/>
            </Grid>
        </GroupBox>
        <Button Content="Изменить запись" HorizontalAlignment="Center" Margin="0,350,0,0" VerticalAlignment="Top" Width="217" Height="26" FontSize="14" Click="Button_Click"/>

    </Grid>
</Window>
