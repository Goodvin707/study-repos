<Window x:Class="ЛБ_27_WPF_DOTMET.AddStudent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ЛБ_27_WPF_DOTMET"
        mc:Ignorable="d"
        Title="AddStudent" Height="350" Width="200">
    <Grid>
        <StackPanel>
            <Label>NumBook</Label>
            <TextBox x:Name="NumBookText" Margin="10"></TextBox>
            <Label>Name</Label>
            <TextBox x:Name="NameText" Margin="10"></TextBox>
            <Label>Group</Label>
            <TextBox x:Name="GroupText" Margin="10"></TextBox>
            <Label>Year</Label>
            <TextBox x:Name="YearText" Margin="10"></TextBox>
        </StackPanel>
        <Button Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Button_Click_1">OK</Button>
        <Button Width="100" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="Button_Click">Cancel</Button>
    </Grid>
</Window>
