<Window x:Class="_27._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_27._1"
        mc:Ignorable="d"
        Title="27__1" Height="259.506" Width="484.923">
    <Grid>
        <Slider Name="slider1" HorizontalAlignment="Left" Margin="42,36,0,0" VerticalAlignment="Top" Width="204" Height="31" Minimum="1" Value="10" Maximum="26"/>
        <Slider Name="slider2" HorizontalAlignment="Left" Margin="42,75,0,0" VerticalAlignment="Top" Width="204" Height="31" Value= "{Binding Value, ElementName=slider1}" Minimum="1" Maximum="26"/>

        <Label Name="lable" Content="Строка тут " HorizontalAlignment="Left" Margin="42,178,0,0" VerticalAlignment="Top" 
               FontSize="{Binding Value,ElementName=slider1}" 
               FontFamily="{Binding SelectedItem.FontFamily,ElementName=Combo1}"
               Foreground="{Binding SelectedItem.Foreground,ElementName=Combo2}"/>
        <ComboBox Name="Combo1" HorizontalAlignment="Left" Margin="42,141,0,0" VerticalAlignment="Top" Width="132">
            <ComboBoxItem Content="Consolas" FontFamily="Consolas"/>
            <ComboBoxItem Content="Times New Roman" FontFamily="Times New Roman"/>
        </ComboBox>
        <ComboBox Name="Combo2" HorizontalAlignment="Left" Margin="191,141,0,0" VerticalAlignment="Top" Width="132">
            <ComboBoxItem Content="Red" Foreground="Red"/>
            <ComboBoxItem Content="Green" Foreground="#FF00FF0E"/>
            <ComboBoxItem Content="Blue" Foreground="#FF0039FF"/>
        </ComboBox>
        <ComboBox Name="Combo3"  HorizontalAlignment="Left" Margin="333,142,0,0" VerticalAlignment="Top" Width="132" SelectionChanged="Combo3_SelectionChanged">
            <ComboBoxItem Content="Red" Foreground="Red"/>
            <ComboBoxItem Content="Green" Foreground="#FF00FF0E"/>
            <ComboBoxItem Content="Blue" Foreground="#FF0039FF"/>
        </ComboBox>
        <Label Content="Шрифт" HorizontalAlignment="Left" Margin="47,111,0,0" VerticalAlignment="Top"/>
        <Label Content="Цвет текста" HorizontalAlignment="Left" Margin="191,111,0,0" VerticalAlignment="Top"/>
        <Label Content="Цвет заливки" HorizontalAlignment="Left" Margin="333,111,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>