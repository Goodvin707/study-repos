<Window x:Class="_28__1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_28__1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Slider Minimum="8" Maximum="30" x:Name="SliderFontSize" Margin="10,10,10,0" Height="64" VerticalAlignment="Top" Value="15"></Slider>
        <TextBlock x:Name="Message" FontSize="{Binding ElementName=SliderFontSize, Path=Value}" Margin="10,41,10,10">
  Пример WPF-приложения для демонстрации привязки данных
        </TextBlock>
        <!--При неправильных значениях приложение запускается, но не работает как ожидается-->
        <!--При неверном ElementName пишет: "Не удается найти источник: ElementName=zxc".-->
        <!--При неверном Path пишет: Свойство zxc не найдено для объекта типа Slider.-->
    </Grid>
</Window>