<Window x:Class="_29__4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_29__4"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="400">
    <Grid Background="#FF008250">
        <Ellipse x:Name="elipse" Width="300" Height="300">
            <Ellipse.Fill>
                <RadialGradientBrush x:Name="elipse1" GradientOrigin="0.75,0.25">
                    <GradientStop Color="#FF3B88B9" Offset="0"></GradientStop>
                    <GradientStop Color="Black" Offset="1"></GradientStop>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <PointAnimation 
                    Storyboard.TargetName="elipse1"
                    Storyboard.TargetProperty="GradientOrigin"
                    From="1,0" To="0,1" Duration="0:0:3" RepeatBehavior="0:0:0:10"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </Grid>
</Window>