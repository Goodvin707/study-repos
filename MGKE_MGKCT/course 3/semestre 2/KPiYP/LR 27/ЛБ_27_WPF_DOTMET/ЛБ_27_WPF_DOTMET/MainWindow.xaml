<Window x:Class="ЛБ_27_WPF_DOTMET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ЛБ_27_WPF_DOTMET"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <DataGrid x:Name="StudentGrid" Height="150" VerticalAlignment="Top" IsReadOnly="True" Loaded="StudentGrid_Loaded"></DataGrid>
            <DataGrid x:Name="SessionGrid" Height="150" VerticalAlignment="Top" IsReadOnly="True" Loaded="SessionGrid_Loaded"></DataGrid>
        </StackPanel>
        <Button Height="30" Width="100" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="Add" Click="Button_Click"/>
        <Button Height="30" Width="100" VerticalAlignment="Bottom" HorizontalAlignment="Center" Content="Delete" Click="Button_Click_2"/>
        <Button Height="30" Width="100" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="Edit" Click="Button_Click_1"/>
    </Grid>
</Window>
