<Window x:Class="PresentationTier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding НаименованиеМагазина}" Height="568" Width="800"
        WindowStartupLocation="CenterScreen" Background="#FF2B134D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GridForTovar"
              DataContext="{Binding ElementName=MainList, Path=SelectedItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Margin="5" Grid.Row="0" Text="Код:" Foreground="Gainsboro"/>
            <TextBox Margin="5" Grid.Row="0" Grid.Column="1"
                     Text="{Binding Path=КодТовара}"/>
            <TextBlock Margin="5" Grid.Row="1" Text="Наименование:" Foreground="Gainsboro"/>
            <TextBox Margin="5" Grid.Row="1" Grid.Column="1"
                     Text="{Binding Path=НаименованиеТовара}"/>
            <TextBlock Margin="5" Grid.Row="2" Text="Цена:" Foreground="Gainsboro"/>
            <TextBox Margin="5" Grid.Row="2" Grid.Column="1"
                     Text="{Binding Path=ЦенаТовара}"/>
            <TextBlock Margin="5" Grid.Row="3" Text = "Количество:" Foreground="Gainsboro"/>
            <TextBox Margin="5" Grid.Row="3" Grid.Column="1"
                     Text="{Binding Path=КоличествоТовара}"/>
            <TextBlock Margin="5" Grid.Row="4" Text="Магазин:" Foreground="Gainsboro"/>
            <TextBox Margin="5,3,5,5" Grid.Row="4"
                     Grid.Column="1"
                     Text="{Binding Path=ОписаниеТовара}"/>
            <TextBlock Margin="5" Grid.Row="6" Text="Bcero по товару:" Foreground="Gainsboro"/>
            <TextBox Margin="5" Grid.Row="6" Grid.Column="1"
                     Text="{Binding Path=СуммарнаяСтоимостьПозиции, Mode=OneWay}"/>
        </Grid>
        <Grid Grid.Row="1" Name="GridForCollections">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="13*"/>
                <ColumnDefinition Width="187*"/>
            </Grid.ColumnDefinitions>
            <ListBox Name="MainList" ItemsSource="{Binding Path=СписокТоваров, Mode=OneWay}"
                     DisplayMemberPath="ПредставлениеТовара" Background="#FFC2A1FF" Margin="10,35,10,0" Grid.ColumnSpan="2" Height="175" VerticalAlignment="Top"/>
            <TextBlock Margin="10,10,686,288" Text="Список товаров" Foreground="Gainsboro" Grid.ColumnSpan="2"/>
            <TextBlock Margin="353,214,132,76" Text="Суммарная стоимость для каждого товара" Foreground="Gainsboro" Grid.Column="1"/>
            <TextBlock Text="Средняя цена товара по каждому магазину" Foreground="Gainsboro" Grid.ColumnSpan="2" Margin="10,214,512,76"/>
            <ListBox x:Name="averList" Grid.ColumnSpan="2" Margin="10,239,0,0" HorizontalAlignment="Left" Width="390" Background="#FFC9B3F3"/>
            <ListBox x:Name="sumList" Margin="353,239,0,0" HorizontalAlignment="Left" Width="385" Grid.Column="1" Background="#FF836DAC"/>
        </Grid>
        <Grid Grid.Row="2" Name="GridForItog">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="5" Text="Cyммapнaя стоимость:" Grid.Column="0" HorizontalAlignment="Right" Foreground="#FFC1C1C1"/>
            <TextBox Margin="5" Grid.Column="1"
                     Text="{Binding Path=СуммарнаяСтоимость, Mode=OneWay}"/>
            <TextBlock Margin="5" Text = "Bcero товаров:" Grid.Column="2" HorizontalAlignment="Right" Foreground="#FFC1C1C1"/>
            <TextBox Margin="5" Grid.Column="3" Text="{Binding Path=СуммарноеКоличество, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Window>