<Window x:Class="_29__2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_29__2"
        mc:Ignorable="d"
        Title="Пульсирую" Height="400" Width="400">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <EventTrigger.Actions>
                <BeginStoryboard>
                    <Storyboard TargetProperty="(Ellipse.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"  TargetName="elipse">
                        <DoubleAnimation From="0" To="0.9"
    AutoReverse="True"
    RepeatBehavior="0:0:10"
    Duration="0:0:1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger.Actions>
        </EventTrigger>
    </Window.Triggers>
    <Grid Background="Black">
        <Ellipse x:Name="elipse" HorizontalAlignment="Center" Height="100" VerticalAlignment="Center" Width="100">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="Red" Offset="0"/>
                    <GradientStop Color="#FFFFF900" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Window>